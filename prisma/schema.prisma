generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         String     @default("SUPER_ADMIN")
  createdAt    DateTime   @default(now()) @map("created_at")
  logs         AdminLog[]

  @@map("admins")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Collection {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  createdAt DateTime            @default(now()) @map("created_at")
  products  ProductCollection[]

  @@map("collections")
}

model Tag {
  id   String       @id @default(cuid())
  name String
  slug String       @unique
  products ProductTag[]

  @@map("tags")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Product {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  brand                String
  description          String
  categoryId           String              @map("category_id")
  imageUrl             String              @map("image_url")
  basePrice            Decimal             @map("base_price") @db.Decimal(10, 2)
  stockWeight          Int                 @default(0) @map("stock_weight")
  lowStockThreshold    Int                 @default(500) @map("low_stock_threshold")
  status               ProductStatus       @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")
  cartItems            CartItem[]
  orderItems           OrderItem[]
  category             Category            @relation(fields: [categoryId], references: [id])
  volumes              ProductVolume[]
  sales                ProductSales?
  inventoryLogs        InventoryLog[]
  images               ProductImage[]
  collections          ProductCollection[]
  tags                 ProductTag[]

  @@index([categoryId])
  @@index([brand])
  @@index([slug])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductVolume {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  weight    Int?
  price     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, weight])
  @@map("product_volumes")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCollection {
  id           String     @id @default(cuid())
  productId    String     @map("product_id")
  collectionId String     @map("collection_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@map("product_collections")
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  tagId     String  @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  wilayaNumber String?   @map("wilaya_number")
  wilayaName   String?   @map("wilaya_name")
  wilaya       String?
  address   String
  shopName  String   @map("shop_name")
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart?
  orders    Order[]

  @@index([phone])
  @@map("customers")
}

model Order {
  id              String      @id @default(cuid())
  customerId      String      @map("customer_id")
  totalPrice      Decimal     @map("total_price") @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  shippingCompany String?     @map("shipping_company")
  trackingNumber  String?     @map("tracking_number")
  shippingDate    DateTime?   @map("shipping_date")
  wilayaNumber    String?     @map("wilaya_number")
  wilayaName      String?     @map("wilaya_name")
  amountPaid      Decimal     @default(0) @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]
  invoice         Invoice?
  customer        Customer    @relation(fields: [customerId], references: [id])
  logs            OrderLog[]

  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  quantity       Int
  volumeId       String  @map("volume_id")
  price          Decimal @db.Decimal(10, 2)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  volume         ProductVolume @relation(fields: [volumeId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique @map("customer_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("cart")
}

model CartItem {
  id             String  @id @default(cuid())
  cartId         String  @map("cart_id")
  productId      String  @map("product_id")
  quantity       Int
  volumeId       String  @map("volume_id")
  cart           Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  volume         ProductVolume @relation(fields: [volumeId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique @map("order_id")
  invoiceNumber String   @unique @map("invoice_number")
  issueDate     DateTime @default(now()) @map("issue_date")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([invoiceNumber])
  @@map("invoices")
}

model OrderLog {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedBy String      @map("changed_by") // "ADMIN" or "CUSTOMER" or "SYSTEM"
  message   String
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_logs")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  PREPARING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

model ProductSales {
  id        String   @id @default(cuid())
  productId String   @unique @map("product_id")
  unitsSold Int      @default(0) @map("units_sold")
  revenue   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([unitsSold(sort: Desc)])
  @@map("product_sales")
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // LOW_STOCK, NEW_ORDER, NEW_CUSTOMER
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  String?  // JSON string for extra data
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

enum InventoryChangeType {
  SALE
  CANCEL
  RESTOCK
  MANUAL_ADJUSTMENT
  INITIAL_STOCK
}

enum InventorySource {
  ORDER
  ADMIN
  SYSTEM
}

model InventoryLog {
  id         String              @id @default(cuid())
  productId  String              @map("product_id")
  changeType InventoryChangeType @map("change_type")
  quantity   Int                 // negative for decrements, positive for increments
  source     InventorySource
  reason     String?
  createdAt  DateTime            @default(now()) @map("created_at")
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changeType])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_logs")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   String?  // JSON string
  createdAt  DateTime @default(now()) @map("created_at")

  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("admin_logs")
}

model SystemError {
  id         String   @id @default(cuid())
  path       String?
  method     String?
  message    String
  stackTrace String?  @map("stack_trace")
  metadata   String?  // JSON string
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("system_errors")
}

model SystemLog {
  id          String   @id @default(cuid())
  eventType   String   @map("event_type")
  entityId    String?  @map("entity_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}
